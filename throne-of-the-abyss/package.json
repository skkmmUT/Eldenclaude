{
  "name": "throne-of-the-abyss",
  "private": true,
  "version": "0.1.0",
  "description": "Throne of the Abyss — a dark-fantasy soulslike action RPG built on Three.js + TypeScript",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node tools/smoke-test.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.2.8",
    "@fontsource/cormorant-garamond": "5.2.8",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
